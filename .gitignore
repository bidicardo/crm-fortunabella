# Секреты и настройки окружения
.env
.env.*
!.env.example

# Зависимости
node_modules/
vendor/

# Python
__pycache__/
*.pyc

# Логи, временные данные, загруженные документы
# (storage/ не игнорируется блоком — Laravel сам держит структуру папок
# через вложенные .gitignore и игнорирует их содержимое, см. раздел Laravel ниже)
uploads/
backups/
*.log

# Локальные базы данных
database/*.sqlite

# Настройки редакторов и ОС
.idea/
.vscode/
.DS_Store

# Laravel
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
.phpunit.cache/
.phpunit.result.cache
auth.json
Homestead.json
Homestead.yaml
Thumbs.db